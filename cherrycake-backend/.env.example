DB_URL=jdbc:postgresql://localhost:5432/cherrycake
DB_USER=cherrycake
DB_PASSWORD=change_me
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email for sign-in codes (optional). Without SPRING_MAIL_HOST the code is printed in the backend log.
# Yandex example: host smtp.yandex.ru, port 587, username = full Yandex address, password = Yandex APP password.
# Keep these lines commented out until you have SMTP details: an empty SPRING_MAIL_HOST is treated as "not configured".
# SPRING_MAIL_HOST=smtp.yandex.ru
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# MAIL_FROM=same address as SPRING_MAIL_USERNAME (optional, this is the default)

# Hosts that block SMTP ports (Render free web services) need the HTTPS API instead:
# BREVO_API_KEY=xkeysib-...   (Brevo: Settings > SMTP & API > API keys)
# MAIL_FROM=sender address verified in Brevo (Senders, Domains & Dedicated IPs)
